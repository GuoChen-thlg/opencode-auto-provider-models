{
  "name": "@guochen-thlg/opencode-auto-provider-models",
  "version": "0.3.0",
  "description": "OpenCode plugin that auto-syncs models for an OpenAI-compatible provider.",
  "keywords": [
    "opencode",
    "plugin",
    "openai-compatible",
    "models"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuoChen-thlg/opencode-auto-provider-models.git"
  },
  "homepage": "https://github.com/GuoChen-thlg/opencode-auto-provider-models#readme",
  "bugs": {
    "url": "https://github.com/GuoChen-thlg/opencode-auto-provider-models/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "test": "node --test",
    "dev": "./node_modules/.bin/opencode",
    "pack": "npm pack --pack-destination .",
    "dev-install": "npm run pack && npm install -g ./guochen-thlg-opencode-auto-provider-models-*.tgz && rm guochen-thlg-opencode-auto-provider-models-*.tgz"
  },
  "files": [
    "index.js",
    "enrichment.js",
    "README.md",
    "README.zh-CN.md"
  ],
  "dependencies": {
    "effect": "^3.22.2"
  },
  "devDependencies": {
    "@opencode/cli": "^2.0.11",
    "@opencode/plugin": "^2.0.11"
  }
}
